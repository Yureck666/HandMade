{
  "name": "uyutnyi-ugolok-admin",
  "version": "1.0.0",
  "description": "Админка для сайта \"Уютный уголок\" — добавление товаров и публикация на сайт",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ru.uyutnyiugolok.admin",
    "productName": "Админка",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Админка.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
